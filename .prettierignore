# Root-level ignores for Prettier
# Note: Prettier doesn't walk up to find .prettierignore when run from subdirs,
# so each app may need its own .prettierignore for app-specific patterns.

# Dependencies
node_modules/

# Vendored third-party source, kept byte-identical to upstream
vendor/

# Build outputs
**/dist/
**/build/
**/.svelte-kit/
**/.astro/

# Rust
**/src-tauri/

# Lock files
pnpm-lock.yaml
