{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // Nothing here is compiled by `tsc`: Wrangler bundles the Worker and Vite bundles the tests.
    // The `.ts` extension lets `vitest.config.ts` import the workerd project's test list without
    // tripping Vite's native config loader, which refuses extensionless imports.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    // No ambient `@types/*` packages. The Worker runtime globals come from the generated
    // `worker-configuration.d.ts` in `include` below; Node's would type globals the Worker
    // doesn't have.
    "types": []
  },
  // `worker-configuration.d.ts` is generated by `wrangler types` (gitignored; written on install
  // and by the `api-server-worker-types` check). It declares every Worker runtime global for this
  // Worker's `compatibility_date`, plus the `Env` shape derived from `wrangler.toml`.
  "include": ["src/**/*", "vitest.config.ts", "vitest.workerd.config.ts", "worker-configuration.d.ts"]
}
