From 1bde4cde629a2fbb2618a5792eb66256215259f9 Mon Sep 17 00:00:00 2001
From: David Veszelovszki <veszelovszki@gmail.com>
Date: Tue, 22 Sep 2026 21:02:07 +0200
Subject: [PATCH] fix: record an interface whose multicast join failed, ending
 an endless retry

`add_interface` returned early when `join_multicast_group` failed on a new
interface, so the interface never reached `my_intfs`. `check_ip_changes` then
rediscovered it on every run, retried the join, failed the same way, and logged
again, with no exit as long as the interface existed.

The join can fail permanently. `join_multicast_group` joins IPv4 by interface
address, so two interfaces sharing one address race for a single membership and
the second `IP_ADD_MEMBERSHIP` returns `EADDRINUSE`. macOS's Virtualization
framework creates that pair for every VM bridge (`bridge1NN` alongside
`vmenetN`), so any machine running Docker Desktop, OrbStack, or UTM hits it. One
39-hour run logged 9,322 retries for a single `bridge102` at a steady five-second
cadence, 87,600 of 87,667 total join attempts in the window, and 29.4 MB of log.

Record the interface even when the join fails, which is what the `Entry::Occupied`
arm a few lines above already does for an added address. Sending does not depend
on the membership, so an interface that cannot receive is still worth announcing
and querying on, and for the `EADDRINUSE` case the socket already holds the
membership through the sibling interface. When the interface's address later
changes, the occupied arm attempts the join again.
---
 src/service_daemon.rs | 60 +++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 58 insertions(+), 2 deletions(-)

diff --git a/src/service_daemon.rs b/src/service_daemon.rs
index 5e50bcf..86ce2d2 100644
--- a/src/service_daemon.rs
+++ b/src/service_daemon.rs
@@ -2137,9 +2137,14 @@ impl Zeroconf {
                 }
             }
             Entry::Vacant(entry) => {
+                // Record the interface even when the join fails, the same way the
+                // occupied arm above does. Dropping it here would leave it absent
+                // from `my_intfs`, so every `check_ip_changes` would rediscover it
+                // and retry the join for as long as it exists. Sending does not
+                // depend on the join, and a later address change takes the occupied
+                // arm, which retries it.
                 if let Err(e) = join_multicast_group(&sock.pktinfo, intf) {
-                    debug!("add_interface: socket_config {}: {e}. Skipped.", &intf.name);
-                    return;
+                    debug!("add_interface: socket_config {}: {e}", &intf.name);
                 }
 
                 new_addr = true;
@@ -5438,6 +5443,57 @@ mod tests {
         })
     }
 
+    #[test]
+    fn test_failed_multicast_join_records_interface() {
+        // A multicast join can keep failing for as long as an interface exists:
+        // `join_multicast_group` joins IPv4 by interface ADDRESS, so two interfaces
+        // sharing one address make the second `IP_ADD_MEMBERSHIP` fail with
+        // `EADDRINUSE` (on macOS the Virtualization framework pairs every `bridgeN`
+        // with a `vmenetN` that way). If such an interface is left out of
+        // `my_intfs`, every `check_ip_changes` tick sees it as new, retries the
+        // join, fails, and logs, for as long as the daemon runs.
+        let signal = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let signal_addr = signal.local_addr().unwrap();
+        signal.set_nonblocking(true).unwrap();
+        let port = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0))
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port();
+        let (sender, _receiver) = flume::bounded(100);
+        let mut daemon = super::Zeroconf::new(
+            mio::net::UdpSocket::from_std(signal),
+            mio::Poll::new().unwrap(),
+            port,
+            sender,
+            signal_addr,
+        );
+
+        // TEST-NET-1 is never assigned to a host interface, so the kernel rejects a
+        // join on it the same way it rejects a conflicting address, without this
+        // test having to arrange two interfaces.
+        let if_index = 65_535;
+        let intf = test_interface(
+            "mdns-sd-unjoinable",
+            if_index,
+            test_ifaddr_v4(Ipv4Addr::new(192, 0, 2, 1)),
+        );
+
+        let sock = daemon.ipv4_sock.as_ref().expect("no IPv4 socket");
+        assert!(
+            super::join_multicast_group(&sock.pktinfo, &intf).is_err(),
+            "precondition: joining the mDNS group on an unassigned address must fail"
+        );
+
+        daemon.add_interface(&intf, std::slice::from_ref(&intf));
+
+        assert!(
+            daemon.my_intfs.contains_key(&if_index),
+            "an interface whose multicast join failed must still be recorded, \
+             otherwise every IP check retries the join and logs again"
+        );
+    }
+
     #[test]
     fn test_excluded_address_preserves_announced_service() {
         use crate::service_info::ServiceStatus;
-- 
